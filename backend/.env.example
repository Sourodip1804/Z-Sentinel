# MongoDB — Atlas connection string, local instance, or mongomock://
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=zsentinel
# Fallback to in-memory mongomock if MongoDB is unreachable
MONGODB_FALLBACK_MOCK=true

# API Server Configuration
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO

# Offline-trained artifact (never retrained per request)
MODEL_ARTIFACT_PATH=../ml/artifacts/zsentinel_pipeline_v1.joblib

# Prototype risk policy thresholds (balanced on validation data)
RISK_MEDIUM_THRESHOLD=0.25
RISK_HIGH_THRESHOLD=0.60

# Optional PayPal Sandbox (leave empty to disable)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_MODE=sandbox

# Optional GenAI investigation summary (service functions fully without GenAI)
GENAI_ENABLED=false
GENAI_API_KEY=
GENAI_API_URL=
GENAI_MODEL=
